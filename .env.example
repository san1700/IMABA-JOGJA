# ==============================================================================
# IMABA JOGJA - Environment Variables Template
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings > Environment Variables.
# ==============================================================================

# Sanity CMS Project Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID="d109xcpl"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-11-06"

# Sanity On-Demand Revalidation Webhook Secret
# Generate a random secret string and match it in Sanity Management > Webhooks
SANITY_REVALIDATE_SECRET="your-random-secure-webhook-secret"

# Production Site URL (used for absolute OpenGraph, sitemap, and canonical tags)
NEXT_PUBLIC_SITE_URL="https://imabayogyakarta.com"
